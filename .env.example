# Copy to .env, edit what differs on your machine, then `source .env`.
# Every variable here already has a default in eveworld/common/env.sh;
# uncomment a line only when you need to override it.

# --- Data and checkpoints -------------------------------------------------
GAGI_ROOT=$HOME/gagi
# GW0_MODEL_DIR=$GAGI_ROOT/giga_world_0_video_pretrain
# GR1_DATA_ROOT=$GAGI_ROOT/gr1_finetune_data
# EVE_VIDEO_ROOT=$GAGI_ROOT/giga_world_0_outputs
# EVE_OUT=$GAGI_ROOT/eve_outputs

# --- Runtime --------------------------------------------------------------
# PYBIN=python3
# CONDA_ENV=EVEWorld
# MLR_CONDA_ENV=EVEWorld
# TRAIN_VENV=giga_world_train_venv
# EVAL_CONDA_ENV=WorldArena
# GEN_CONDA_ENV=giga_world1

# --- External detectors ---------------------------------------------------
# Only needed for IGR annotation and the MLR occlusion rules.
# GDINO_PATH=/path/to/GroundingDINO/weights
# SAM2_CHECKPOINT=/path/to/sam2.1_hiera_large.pt

# --- Judging endpoints ----------------------------------------------------
# Only needed for instruction-following evaluation.
# OPENAI_API_KEY=
# DIFROST_API_TOKEN=
# DIFROST_GENAI_BASE_URL=
# DIFROST_HOST=
# DIFROST_MODEL=
